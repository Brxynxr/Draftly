# Environment
ENVIRONMENT=development

# Database (PostgreSQL / Supabase / Neon)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/draftly

# Security & JWT
SECRET_KEY=change-this-in-production-secret-key-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Multi-Provider AI Configuration
# Options: "gemini", "groq", "openai", "ollama", "anthropic"
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash

# API Keys (Provide the one corresponding to AI_PROVIDER)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local AI / Ollama Base URL (if using Ollama)
AI_BASE_URL=http://localhost:11434/v1
